index 0000000..19a8301
--- /dev/null
+++ b/scripts/ladder-3e17-run/sampler.sh
@@ -0,0 +1,14 @@
+#!/bin/bash
+# every 60 s: time (PT), MemAvailable and free MB, load, data files done, lean processes, their RSS sum
+L=~/ladder-3e17-logs
+O=~/ladder-3e17/.lake/build/lib/lean/TernaryGoldbach/Ladder/Data
+[ -s $L/mem.tsv ] || echo -e "time_pt\tavail_mb\tfree_mb\tload1\tload5\tdone\tlean_procs\tlean_rss_mb" > $L/mem.tsv
+while true; do
+  a=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo); f=$(awk '/MemFree/{print int($2/1024)}' /proc/meminfo)
+  read l1 l5 _ < /proc/loadavg
+  d=$(ls $O 2>/dev/null | grep -c '^L[0-9]\{4\}\.olean$')
+  r=$(ps -C lean -o rss= | awk '{s+=$1;n++} END{printf "%d\t%d", n, s/1024}')
+  echo -e "$(TZ=America/Los_Angeles date '+%F %T')\t$a\t$f\t$l1\t$l5\t$d\t$r" >> $L/mem.tsv
+  [ -e $L/BUILD_DONE ] && break
+  sleep 60
+done
