+++ b/scripts/ladder-3e17-run/sched.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Memory-aware scheduler for the 2205 ladder data files of ~/ladder-3e17.
+
+Lake has no job-count option, so this runs one `nice -n 19 lake build <module>` per data file, at most
+MAXJOBS at a time (default 8, override in ~/ladder-3e17-logs/maxjobs), and starts a new one only when
+MemAvailable minus the growth still expected from the running jobs leaves RESERVE free: 10 GB while
+any process from ~/reams-replay runs, 3 GB after. A file whose build fails is retried later (an OOM
+kill lowers MAXJOBS by one). Files whose .olean exists are skipped, so rerunning resumes. After all
+files: the full `lake build TernaryGoldbach LadderHints Challenge Solution`.
+"""
+import os, subprocess, time, datetime, pathlib, sys
+
+HOME = pathlib.Path.home()
+REPO = HOME / "ladder-3e17"
+LOGS = HOME / "ladder-3e17-logs"
+OLEAN = REPO / ".lake/build/lib/lean/TernaryGoldbach/Ladder/Data"
+NFILES = 2205
+PEAK_MB = int(os.environ.get("PEAK_MB", "2600"))  # per-file peak RSS budget (pilot + margin)
+GB = 1024
+ENV = dict(os.environ, LEAN_NUM_THREADS="8")
+
+def now():
+    return datetime.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")
+
+def log(msg):
+    with open(LOGS / "sched.log", "a") as f:
+        f.write(f"{now()} {msg}\n")
+
+def avail_mb():
+    for line in open("/proc/meminfo"):
+        if line.startswith("MemAvailable:"):
+            return int(line.split()[1]) // 1024
+    return 0
+
+def replay_busy():
+    """A lake, lean or comparator process whose working directory is ~/reams-replay."""
+    target = str(HOME / "reams-replay")
+    for d in os.listdir("/proc"):
+        if not d.isdigit():
+            continue
+        try:
+            cwd = os.readlink(f"/proc/{d}/cwd")
+            comm = open(f"/proc/{d}/comm").read().strip()
+        except OSError:
+            continue
+        if (cwd == target or cwd.startswith(target + "/")) and comm in ("lake", "lean", "leanexport", "comparator"):
+            return True
+    return False
+
+def rss_mb(pid):
+    tot = 0
+    try:
+        kids = subprocess.run(["ps", "--ppid", str(pid), "-o", "pid="], capture_output=True, text=True).stdout.split()
+        for p in [str(pid)] + kids:
+            for k in subprocess.run(["ps", "--ppid", p, "-o", "pid="], capture_output=True, text=True).stdout.split() + [p]:
+                try:
+                    for line in open(f"/proc/{k}/status"):
+                        if line.startswith("VmRSS:"):
+                            tot += int(line.split()[1]) // 1024
+                except OSError:
+                    pass
+    except Exception:
+        pass
+    return tot
+
+def maxjobs(default):
+    try:
+        return int((LOGS / "maxjobs").read_text().strip())
+    except Exception:
+        return default
+
+def done(k):
+    return (OLEAN / f"L{k:04d}.olean").exists()
+
+def inflight():
+    """Ladder lake builds already running (e.g. left by a previous scheduler): {k: lake pid}."""
+    out = {}
+    for d in os.listdir("/proc"):
+        if not d.isdigit():
+            continue
+        try:
+            if open(f"/proc/{d}/comm").read().strip() != "lake":
+                continue
+            args = open(f"/proc/{d}/cmdline").read().split(chr(0))
+        except OSError:
+            continue
+        for a in args:
+            if a.startswith("TernaryGoldbach.Ladder.Data.L"):
+                out[int(a[-4:])] = int(d)
+    return out
+
+def oom_seen(since):
+    out = subprocess.run(["dmesg"], capture_output=True, text=True).stdout
+    return "Out of memory" in out or "oom-kill" in out
+
+def main():
+    LOGS.mkdir(exist_ok=True)
+    (LOGS / "files").mkdir(exist_ok=True)
+    jobcap = maxjobs(8)
+    todo = [k for k in range(NFILES) if not done(k)]
+    log(f"start: {NFILES - len(todo)} done, {len(todo)} to build, cap {jobcap}")
+    running = {}  # k -> (Popen, start)
+    adopted = inflight()  # k -> lake pid, builds still running from before this scheduler started
+    todo = [k for k in todo if k not in adopted]
+    if adopted:
+        log(f"adopted {len(adopted)} in-flight builds: {sorted(adopted)}")
+    fails = {}
+    oom0 = oom_seen(0)
+    while todo or running or adopted:
+        for k, pid in list(adopted.items()):
+            if os.path.exists(f"/proc/{pid}"):
+                continue
+            del adopted[k]
+            if done(k):
+                log(f"L{k:04d} ok (adopted)")
+            else:
+                log(f"L{k:04d} adopted build ended without .olean; requeued")
+                todo.append(k)
+        for k, (p, t0) in list(running.items()):
+            rc = p.poll()
+            if rc is None:
+                continue
+            del running[k]
+            dt = time.time() - t0
+            if rc == 0 and done(k):
+                log(f"L{k:04d} ok {dt:.0f}s")
+            else:
+                fails[k] = fails.get(k, 0) + 1
+                log(f"L{k:04d} FAILED rc={rc} after {dt:.0f}s (attempt {fails[k]})")
+                if not oom0 and oom_seen(0):
+                    jobcap = max(1, jobcap - 1)
+                    (LOGS / "maxjobs").write_text(f"{jobcap}\n")
+                    log(f"OOM seen in dmesg: cap lowered to {jobcap}")
+                    oom0 = True
+                if fails[k] < 3:
+                    todo.append(k)
+        cap = maxjobs(jobcap)  # live; raising the file now raises the cap too
+        reserve = 10 * GB if replay_busy() else 3 * GB
+        growth = sum(max(0, PEAK_MB - rss_mb(p.pid)) for p, _ in running.values())
+        growth += sum(max(0, PEAK_MB - rss_mb(pid)) for pid in adopted.values())
+        if todo and len(running) + len(adopted) < cap and avail_mb() - growth >= reserve + PEAK_MB:
+            k = todo.pop(0)
+            lf = open(LOGS / "files" / f"L{k:04d}.log", "w")
+            p = subprocess.Popen(["nice", "-n", "19", "/usr/bin/time", "-v", "-o", str(LOGS / "files" / f"L{k:04d}.time"),
+                                  "lake", "build", f"TernaryGoldbach.Ladder.Data.L{k:04d}"],
+                                 cwd=REPO, env=ENV, stdout=lf, stderr=subprocess.STDOUT)
+            running[k] = (p, time.time())
+            time.sleep(3)  # let lake start before the next memory reading
+            continue
+        time.sleep(10)
+    bad = [k for k in range(NFILES) if not done(k)]
+    log(f"data files finished; missing: {bad[:20]}{'...' if len(bad) > 20 else ''}")
+    if bad:
+        sys.exit(1)
+    log("full build start")
+    with open(LOGS / "build.log", "w") as lf:
+        rc = subprocess.run(["nice", "-n", "19", "/usr/bin/time", "-v", "-o", str(LOGS / "build.time"),
+                             "lake", "build", "TernaryGoldbach", "LadderHints", "Challenge", "Solution"],
+                            cwd=REPO, env=ENV, stdout=lf, stderr=subprocess.STDOUT).returncode
+    log(f"full build exit={rc}")
+    (LOGS / "BUILD_DONE").write_text(f"{rc} {now()}\n")
+
+if __name__ == "__main__":
+    main()
