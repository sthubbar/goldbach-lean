+import TernaryGoldbach.MainTheorems
+import RSBounds.Moebius003.Upstream
+
+/-!
+# The main theorems with two hypotheses
+
+`RamareMoebius` follows from `PlattGRH`: `PlattGRH` at `q = 1` gives RH up to `10⁸`
+(`Explicit.rh_upto_1e8`), and Helfgott's RSBounds project proves `RamareMoebius` from RH up to
+`1894438.5122` (`TernaryGoldbach.RSBounds.Moebius003.ramareMoebius_of_plattGRH`). So the main
+theorems of `TernaryGoldbach/MainTheorems.lean` hold without the hypothesis `hμ`.
+-/
+
+namespace TernaryGoldbach
+
+/-- Ramaré's bound for `∑ μ(n)/n`, from Platt's GRH verification (Helfgott, RSBounds). -/
+theorem ramareMoebius_of_plattGRH (hGRH : PlattGRH) : RamareMoebius :=
+  TernaryGoldbach.RSBounds.Moebius003.ramareMoebius_of_plattGRH hGRH
+
+/-- Every odd `n ≥ 10²⁷` is a sum of three primes, given Platt's GRH verification. -/
+theorem ternary_goldbach_large_of_plattGRH (hGRH : PlattGRH) : TernaryGoldbachFrom (10 ^ 27) :=
+  ternary_goldbach_large_of_hypotheses hGRH (ramareMoebius_of_plattGRH hGRH)
+
+/-- **The ternary Goldbach conjecture**, given Platt's GRH verification and binary Goldbach up to
+`4·10¹⁸`. -/
+theorem ternary_goldbach_of_two_hypotheses (hGRH : PlattGRH) (hBG : BinaryGoldbachInput) :
+    Statement :=
+  ternary_goldbach_of_hypotheses hGRH hBG (ramareMoebius_of_plattGRH hGRH)
+
+end TernaryGoldbach
